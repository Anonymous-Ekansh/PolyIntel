# ============================================================
# PolyIntel Environment Variables
# ============================================================

# Polymarket API endpoints (public, no auth needed for read-only)
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API=https://clob.polymarket.com
POLYMARKET_DATA_API=https://data-api.polymarket.com

# Set to "true" when deploying backend on EU/US server to bypass Indian ISP DNS blocks
POLYMARKET_PROXY=true

# News APIs
NEWSDATA_API_KEY=your_newsdata_io_api_key_here
RSS2JSON_API_KEY=your_rss2json_api_key_here
